# Copy this file to .env and fill in your keys. Never commit .env.
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=

# Images: google (default, Gemini) or local (FLUX.2 klein on this Mac; see `just setup-local`)
IMAGE_BACKEND=google

# Voiceover: google (default, Gemini TTS) or elevenlabs (needs ELEVENLABS_API_KEY; voice set in animate/voice.py)
VOICE_BACKEND=google
